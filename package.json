{
  "name": "unpako",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "turbo run dev:base",
    "build": "turbo run build:base",
    "lint": "turbo run lint:base",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "turbo run test:base",
