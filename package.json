    "release": "semantic-release",
    "build:base": "tsc -b && vite build",
    "dev:base": "vite",
    "lint:base": "eslint .",
    "test:base": "vitest",
    "test:unit:base": "vitest run --reporter=verbose",
    "test:integration:base": "vitest run --reporter=verbose",
    "test:component:base": "vitest run --reporter=verbose",
    "test:e2e:base": "playwright test",
    "test:coverage:base": "vitest run --coverage",
    "typecheck:base": "tsc --noEmit"
